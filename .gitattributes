# CommonMark uses two trailing spaces for an intentional hard line break.
# Keep Git's other whitespace checks active for Markdown and all source files.
*.md whitespace=-blank-at-eol

# Preserve vendored upstream bytes exactly. In particular, wheel metadata and
# source distributions may intentionally retain CRLF or upstream whitespace,
# while their text still remains visible for review.
tools/_vendor/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# PA-S1a keeps the reviewed libedhoc/zcbor bytes exactly as upstream provides
# them; its SHA allow-list, rather than local whitespace normalization, is the
# integrity authority.
third_party/production_attachment_edhoc/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
