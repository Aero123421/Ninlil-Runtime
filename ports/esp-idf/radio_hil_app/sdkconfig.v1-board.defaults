# Overlay for the default-off V1 USB parent diagnostic profile.
# Build with SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.v1-board.defaults"
# and a separate SDKCONFIG/build directory. This is session-only LAB evidence.
CONFIG_NINLIL_ENABLE_R7_FRAG_PRIVATE=y
CONFIG_NINLIL_ENABLE_V1_LAB_RADIO_PATH=y
CONFIG_NINLIL_RADIO_HIL_SESSION_LEDGER_DIAG=y
CONFIG_NINLIL_RADIO_HIL_V1_BOARD=y
