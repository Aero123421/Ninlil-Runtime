{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninlil.dev/schema/hil/ninlil-hil-events-v1.schema.json",
  "title": "Ninlil HIL events v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "run_id", "events"],
  "properties": {
    "schema": {"const": "ninlil-hil-events-v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "events": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_id",
          "case_id",
          "plugin",
          "outcome",
          "origin",
          "observed"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
          "event_id": {"$ref": "#/$defs/id"},
          "case_id": {"$ref": "#/$defs/id"},
          "plugin": {"$ref": "#/$defs/id"},
          "outcome": {"enum": ["PASS", "FAIL", "ERROR"]},
          "origin": {"const": "LOCAL_PLUGIN_OUTPUT_UNVERIFIED"},
          "observed": {
            "type": "object",
            "maxProperties": 256,
            "additionalProperties": {"$ref": "#/$defs/jsonValue"}
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "jsonValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "string", "maxLength": 4096},
        {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    }
  }
}
