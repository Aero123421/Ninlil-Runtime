{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninlil.dev/schema/hil/ninlil-hil-faults-v1.schema.json",
  "title": "Ninlil HIL faults v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "run_id", "faults"],
  "properties": {
    "schema": {"const": "ninlil-hil-faults-v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "faults": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "code", "severity", "plugin", "case_id", "message"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
          "code": {"$ref": "#/$defs/id"},
          "severity": {"enum": ["ERROR", "WARNING"]},
          "plugin": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
          "case_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
          "message": {"type": "string", "maxLength": 1024}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
