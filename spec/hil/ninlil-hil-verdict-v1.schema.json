{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninlil.dev/schema/hil/ninlil-hil-verdict-v1.schema.json",
  "title": "Ninlil HIL verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "run_id",
    "profile",
    "status",
    "evidence_complete",
    "case_counts",
    "passed_cases",
    "failed_cases",
    "fault_count",
    "attestation"
  ],
  "properties": {
    "schema": {"const": "ninlil-hil-verdict-v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "profile": {
      "enum": [
        "esp-storage-atomic-v1",
        "esp-storage-namespace-v1",
        "generic-hil-v1"
      ]
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "evidence_complete": {"type": "boolean"},
    "case_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed", "failed"],
      "properties": {
        "required": {"type": "integer", "minimum": 1, "maximum": 4096},
        "passed": {"type": "integer", "minimum": 0, "maximum": 4096},
        "failed": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "passed_cases": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "failed_cases": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "fault_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "evidence_origin",
        "full_promotion_permitted",
        "runtime_policy",
        "physical_hil_claimed",
        "reason_codes"
      ],
      "properties": {
        "requested": {
          "enum": ["EVIDENCE_ONLY", "FULL_CANDIDATE_REVIEW"]
        },
        "evidence_origin": {
          "const": "LOCAL_PLUGIN_OUTPUT_UNVERIFIED"
        },
        "full_promotion_permitted": {"const": false},
        "runtime_policy": {"const": "ESP_UNPROVEN"},
        "physical_hil_claimed": {"const": false},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
